<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

</head>

<body class="bg-gray-50 text-gray-800">

  <%- include("partials/header.ejs") %>


  <!-- HERO -->

  <section class="relative overflow-hidden bg-[#007A8F] text-white py-28">

    <div
      class="absolute -top-32 -right-32
             w-96 h-96
             bg-[#07C0D4]
             rounded-full
             opacity-30
             blur-3xl">
    </div>

    <div
      class="absolute -bottom-40 -left-32
             w-96 h-96
             bg-white
             rounded-full
             opacity-10
             blur-3xl">
    </div>

    <div class="relative container mx-auto px-6 text-center">

      <p
        class="text-[#07C0D4]
               font-semibold
               uppercase
               tracking-widest
               text-sm
               mb-4"
      >
        Ionos Dessalinização
      </p>

      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        Notícias
      </h1>

      <div
        class="w-24 h-1
               bg-[#07C0D4]
               rounded-full
               mx-auto
               mb-8">
      </div>

      <p
        class="max-w-2xl
               mx-auto
               text-lg md:text-xl
               text-white/90
               leading-8"
      >
        Acompanhe as novidades, conquistas,
        projetos e avanços da Ionos.
      </p>

    </div>

  </section>


  <!-- CONTEÚDO -->

  <main class="py-24">

    <div class="container mx-auto px-6">

      <div class="text-center mb-16">

        <span
          class="uppercase
                 tracking-widest
                 text-[#007A8F]
                 font-semibold
                 text-sm"
        >
          Atualizações
        </span>

        <h2
          class="text-4xl
                 md:text-5xl
                 font-bold
                 text-[#0D0D0D]
                 mt-4"
        >
          Acompanhe nossa jornada
        </h2>

        <div
          class="w-20 h-1
                 bg-[#07C0D4]
                 rounded-full
                 mx-auto
                 mt-5
                 mb-6">
        </div>

      </div>


      <!-- NOTÍCIAS -->

      <% if (noticias.length === 0) { %>

        <div class="text-center py-20">

          <p class="text-gray-500 text-lg">
            Nenhuma notícia publicada no momento.
          </p>

        </div>

      <% } else { %>

        <div
          class="grid
                 md:grid-cols-2
                 lg:grid-cols-3
                 gap-8"
        >

          <% noticias.forEach(noticia => { %>

            <article
              class="group
                     bg-white
                     rounded-3xl
                     overflow-hidden
                     border border-gray-100
                     shadow-lg
                     hover:shadow-2xl
                     hover:-translate-y-2
                     transition-all
                     duration-300"
            >

              <% if (noticia.imagemUrl) { %>

                <img
                  src="<%= noticia.imagemUrl %>"
                  alt="<%= noticia.titulo %>"
                  class="w-full h-48 object-cover"
                >

              <% } else { %>

                <div
                  class="h-48
                         bg-gradient-to-br
                         from-[#007A8F]
                         to-[#07C0D4]
                         flex
                         items-center
                         justify-center"
                >

                  <span
                    class="text-white
                           font-semibold
                           uppercase
                           tracking-widest
                           text-sm"
                  >
                    Ionos
                  </span>

                </div>

              <% } %>


              <div class="p-8">

                <p
                  class="text-[#007A8F]
                         text-sm
                         font-semibold
                         mb-3"
                >
                  Notícias
                </p>

                <h3
                  class="text-2xl
                         font-bold
                         text-[#0D0D0D]
                         mb-4
                         group-hover:text-[#007A8F]
                         transition"
                >
                  <%= noticia.titulo %>
                </h3>

                <p
                  class="text-[#5F5F5F]
                         leading-7
                         mb-6"
                >
                  <%= noticia.descricao %>
                </p>

              </div>

            </article>

          <% }) %>

        </div>

      <% } %>


      <div class="text-center mt-16">

        <a
          href="/"
          class="inline-flex
                 items-center
                 gap-2
                 bg-[#007A8F]
                 hover:bg-[#005F70]
                 text-white
                 font-semibold
                 px-7
                 py-3
                 rounded-xl
                 transition
                 duration-300"
        >
          ← Voltar para o início
        </a>

      </div>

    </div>

  </main>


  <%- include("partials/footer.ejs") %>

  <script src="/js/menu.js"></script>

</body>

</html>