<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Equipe | Ionos</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

</head>

<body class="bg-gray-50 text-gray-800">

  <%- include('partials/header', {
    headerClass: 'header-light'
}) %>

  <!-- HERO -->
 <section class="relative overflow-hidden py-32 bg-gradient-to-br from-[#005A72] via-[#007A8F] to-[#07C0D4]">

  <!-- Círculos decorativos -->
  <div class="absolute inset-0 overflow-hidden">

    <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-white/5"></div>

    <div class="absolute top-16 right-24 w-48 h-48 rounded-full border border-white/10"></div>

    <div class="absolute bottom-20 left-1/4 w-64 h-64 rounded-full border-2 border-white/10"></div>

    <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-white/5"></div>

    <div class="absolute top-1/2 left-12 w-10 h-10 rounded-full bg-white/20"></div>

    <div class="absolute top-32 left-1/2 w-6 h-6 rounded-full bg-white/30"></div>

    <div class="absolute bottom-28 right-1/3 w-8 h-8 rounded-full bg-white/20"></div>

  </div>

  <!-- Conteúdo -->
  <div class="relative container mx-auto px-6 text-center">

    <br>
    <h1 class="text-5xl md:text-6xl font-bold text-white">
      Nossa Equipe
    </h1>

    <div class="w-24 h-1 bg-white rounded-full mx-auto mt-6 mb-8"></div>

    <p class="max-w-3xl mx-auto text-lg text-white/90 leading-8">
      A Ionos reúne profissionais das áreas de engenharia,
      química, pesquisa e desenvolvimento para transformar
      conhecimento científico em soluções sustentáveis para
      dessalinização de água.
    </p>

  </div>

</section>

  <!-- FUNDADORES -->

  <section class="py-24 bg-white">

    <div class="container mx-auto px-6">

      <div class="text-center">

        <h2 class="text-4xl font-bold">
          Fundadores
        </h2>

        <div class="w-20 h-1 bg-cyan-500 rounded-full mx-auto mt-5"></div>

        <p class="text-gray-600 mt-6">
          Idealizadores da Ionos e responsáveis pela visão científica e estratégica.
        </p>

      </div>

      <div class="grid lg:grid-cols-2 gap-20 max-w-5xl mx-auto mt-16">

        <!-- Jessica -->

        <div class="text-center">

          <div class="relative inline-block">

            <div class="absolute inset-0 rounded-full bg-cyan-300 blur-3xl opacity-25 scale-125"></div>

            <img
              src="/images/membros/jessica-miranda.jpg"
              alt="Jessica Miranda"
              class="relative w-56 h-56 rounded-full object-cover border-8 border-white shadow-2xl mx-auto"
            >

          </div>

          <h3 class="text-3xl font-bold mt-8">
            Jessica Miranda
          </h3>

          <p class="text-cyan-600 font-semibold mt-3">
            PhD em Química
          </p>

          <p class="text-gray-600 leading-8 mt-6 max-w-md mx-auto">
            Sócia fundadora e pesquisadora responsável pela liderança
            científica, inovação e desenvolvimento tecnológico da Ionos.
          </p>

        </div>

        <!-- Iago -->

        <div class="text-center">

          <div class="relative inline-block">

            <div class="absolute inset-0 rounded-full bg-cyan-300 blur-3xl opacity-25 scale-125"></div>

            <img
              src="/images/membros/iago-farias.jpeg"
              alt="Iago Farias"
              class="relative w-56 h-56 rounded-full object-cover border-8 border-white shadow-2xl mx-auto"
            >

          </div>

          <h3 class="text-3xl font-bold mt-8">
            Iago Farias
          </h3>

          <p class="text-cyan-600 font-semibold mt-3">
            Sócio Administrador
          </p>

          <p class="text-gray-600 leading-8 mt-6 max-w-md mx-auto">
            Responsável pelo desenvolvimento de hardware,
            estratégia tecnológica e gestão da empresa.
          </p>

        </div>

      </div>

    </div>

  </section>

  <!-- EQUIPE -->

<!-- EQUIPE -->
<section class="py-24 bg-white">

  <div class="container mx-auto px-6">

    <!-- Título -->
    <div class="text-center mb-16">

      <h2 class="text-4xl font-bold text-gray-800">
        Equipe Multidisciplinar
      </h2>

      <div class="w-20 h-1 bg-cyan-500 rounded-full mx-auto mt-5"></div>

      <p class="text-gray-600 mt-6 max-w-3xl mx-auto leading-8">
        Nossa equipe reúne especialistas em engenharia, química,
        software e hardware para desenvolver tecnologias inovadoras
        em dessalinização por Deionização Capacitiva.
      </p>

    </div>

    <!-- Cards -->
    <div class="flex flex-wrap justify-center gap-12">

      <!-- MEMBRO -->
      <div class="w-full sm:w-72 text-center">

        <img
          src="/images/membros/gabriel-gonzaga.jpg"
          alt="Gabriel Gonzaga"
          class="w-40 h-40 mx-auto rounded-full object-cover border-4 border-white shadow-xl">

        <h3 class="mt-6 text-2xl font-semibold">
          Gabriel Gonzaga
        </h3>

        <p class="text-cyan-600 font-medium mt-2">
          Eng. Desenvolvimento & Validação
        </p>

        <p class="text-gray-500 text-sm leading-7 mt-4">
          Atua na validação técnica e na transformação de protótipos
          laboratoriais em soluções para aplicação prática.
        </p>

      </div>

      <!-- MEMBRO -->
      <div class="w-full sm:w-72 text-center">

        <img
          src="/images/membros/bianca-marjorie.jpg"
          alt="Bianca Marjorie"
          class="w-40 h-40 mx-auto rounded-full object-cover border-4 border-white shadow-xl">

        <h3 class="mt-6 text-2xl font-semibold">
          Bianca Marjorie
        </h3>

        <p class="text-cyan-600 font-medium mt-2">
          Analista Química
        </p>

        <p class="text-gray-500 text-sm leading-7 mt-4">
          Responsável pelas análises químicas, validação experimental
          e controle de qualidade.
        </p>

      </div>

      <!-- MEMBRO -->
      <div class="w-full sm:w-72 text-center">

        <img
          src="/images/membros/lucas-sobral.jpg"
          alt="Lucas Sobral"
          class="w-40 h-40 mx-auto rounded-full object-cover border-4 border-white shadow-xl">

        <h3 class="mt-6 text-2xl font-semibold">
          Lucas Sobral
        </h3>

        <p class="text-cyan-600 font-medium mt-2">
          Engenheiro de Software
        </p>

        <p class="text-gray-500 text-sm leading-7 mt-4">
          Desenvolve o aplicativo e integra toda a plataforma digital.
        </p>

      </div>

      <!-- MEMBRO -->
      <div class="w-full sm:w-72 text-center">

        <img
          src="/images/membros/gustavo-seabra.jpg"
          alt="Gustavo Seabra"
          class="w-40 h-40 mx-auto rounded-full object-cover border-4 border-white shadow-xl">

        <h3 class="mt-6 text-2xl font-semibold">
          Gustavo Seabra
        </h3>

        <p class="text-cyan-600 font-medium mt-2">
          Engenheiro de Hardware
        </p>

        <p class="text-gray-500 text-sm leading-7 mt-4">
          Atua no desenvolvimento eletrônico, prototipagem
          e otimização do hardware embarcado.
        </p>

      </div>

      <!-- MEMBRO -->
      <div class="w-full sm:w-72 text-center">

        <img
          src="/images/membros/larissa-holanda.jpeg"
          alt="Larissa Holanda"
          class="w-40 h-40 mx-auto rounded-full object-cover border-4 border-white shadow-xl">

        <h3 class="mt-6 text-2xl font-semibold">
          Larissa Holanda
        </h3>

        <p class="text-cyan-600 font-medium mt-2">
          Engenheira de Software
        </p>

        <p class="text-gray-500 text-sm leading-7 mt-4">
          Responsável pelo desenvolvimento do site institucional,
          experiência do usuário e aplicações web.
        </p>

      </div>

    </div>

  </div>

</section>

<%- include('partials/footer.ejs') %>

<script src="/js/menu.js"></script>

</body>
</html>