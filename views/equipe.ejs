
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Equipe | Ionos Dessalinização</title>
  <meta
    name="description"
    content="Conheça os fundadores e a equipe da Ionos Dessalinização, uma startup que desenvolve soluções tecnológicas para o tratamento e a dessalinização da água."
  >
  <meta name="theme-color" content="#007A8F">

  <link rel="icon" type="image/png" href="/images/logo/icon-ionos.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/equipe.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body class="pagina-equipe">

  <%- include('partials/header.ejs', { headerClass: 'header-light' }) %>

  <main>
    <!-- HERO -->
    <section class="equipe-hero">
      <div class="equipe-hero__pattern" aria-hidden="true"></div>
      <div class="equipe-hero__orb equipe-hero__orb--one" aria-hidden="true"></div>
      <div class="equipe-hero__orb equipe-hero__orb--two" aria-hidden="true"></div>

      <div class="equipe-container equipe-hero__content">
        <span class="equipe-eyebrow equipe-reveal">
          <span class="equipe-eyebrow__line"></span>
          Pessoas por trás da inovação
        </span>

        <h1 class="equipe-hero__title equipe-reveal">
          Grandes ideias começam
          <span>com pessoas.</span>
        </h1>

        <p class="equipe-hero__description equipe-reveal">
          Conheça quem está por trás da Ionos Dessalinização e trabalha
          para transformar conhecimento científico em soluções para os
          desafios do tratamento da água.
        </p>

        <a href="#fundadores" class="equipe-button equipe-button--primary equipe-reveal">
          Conheça nossa equipe
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 5v14m0 0 6-6m-6 6-6-6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <div class="equipe-hero__signature equipe-reveal">
          <span></span>
          Ciência · Colaboração · Tecnologia
        </div>
      </div>

      <div class="equipe-hero__vertical" aria-hidden="true">
        IONOS DESSALINIZAÇÃO
      </div>
    </section>

    <!-- INTRODUÇÃO -->
    <section class="equipe-intro">
      <div class="equipe-container equipe-intro__layout">
        <div class="equipe-intro__heading equipe-reveal">
          <span class="equipe-eyebrow">
            <span class="equipe-eyebrow__line"></span>
            Nossa força
          </span>

          <h2>
            Diferentes talentos.
            <span>Um propósito em comum.</span>
          </h2>
        </div>

        <div class="equipe-intro__text equipe-reveal">
          <p>
            A Ionos reúne pessoas comprometidas com a pesquisa, o
            desenvolvimento tecnológico e a construção de alternativas
            para os desafios relacionados à água.
          </p>

          <p>
            A colaboração entre diferentes conhecimentos e experiências
            faz parte da nossa jornada. Cada pessoa contribui para que
            ideias sejam investigadas, testadas e transformadas em
            possibilidades concretas.
          </p>
        </div>
      </div>
    </section>

    <!-- FUNDADORES -->
    <section class="equipe-section equipe-fundadores" id="fundadores">
      <div class="equipe-container">
        <div class="equipe-section__heading equipe-reveal">
          <span class="equipe-eyebrow">
            <span class="equipe-eyebrow__line"></span>
            Nossa origem
          </span>

          <h2>
            Quem deu início
            <span>a essa jornada.</span>
          </h2>

          <p>
            Conheça as pessoas que estão à frente da criação e do
            desenvolvimento da Ionos Dessalinização.
          </p>
        </div>

        <%
          const listaFundadores = Array.isArray(fundadores) ? fundadores : [];
        %>

        <% if (listaFundadores.length > 0) { %>
          <div class="equipe-grid equipe-grid--fundadores">
            <% listaFundadores.forEach((membro, index) => { %>
              <article
                class="equipe-card equipe-card--fundador equipe-reveal"
                style="--card-index: <%= index %>"
              >
                <div class="equipe-card__photo">
                  <% if (membro.imagemUrl) { %>
                    <img
                      src="<%= membro.imagemUrl %>"
                      alt="Foto de <%= membro.nome %>"
                      loading="lazy"
                      onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    >
                  <% } %>

                  <div
                    class="equipe-card__initial"
                    <% if (membro.imagemUrl) { %>style="display:none"<% } %>
                    aria-hidden="true"
                  >
                    <%= (membro.nome || 'I').trim().charAt(0).toUpperCase() %>
                  </div>

                  <div class="equipe-card__photo-overlay"></div>

                  <span class="equipe-card__badge">
                    Fundador(a)
                  </span>
                </div>

                <div class="equipe-card__content">
                  <span class="equipe-card__number">
                    <%= String(index + 1).padStart(2, '0') %>
                  </span>

                  <h3><%= membro.nome %></h3>

                  <% if (membro.cargo) { %>
                    <p class="equipe-card__role"><%= membro.cargo %></p>
                  <% } %>

                  <% if (membro.descricao) { %>
                    <p class="equipe-card__description"><%= membro.descricao %></p>
                  <% } %>

                  <span class="equipe-card__bottom-line"></span>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <div class="equipe-empty equipe-reveal">
            <div class="equipe-empty__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="8" r="4"
                  stroke="currentColor" stroke-width="1.6"/>
                <path d="M4 21v-2a8 8 0 0 1 16 0v2"
                  stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round"/>
              </svg>
            </div>

            <h3>Fundadores em breve</h3>
            <p>As informações dos fundadores serão disponibilizadas em breve.</p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- EQUIPE -->
    <section class="equipe-section equipe-membros" id="membros">
      <div class="equipe-container">
        <div class="equipe-section__heading equipe-reveal">
          <span class="equipe-eyebrow">
            <span class="equipe-eyebrow__line"></span>
            Nosso time
          </span>

          <h2>
            Conhecimento que
            <span>move a inovação.</span>
          </h2>

          <p>
            Cada integrante contribui com habilidades, ideias e
            dedicação para o desenvolvimento das nossas soluções.
          </p>
        </div>

        <%
          const listaEquipe = Array.isArray(equipe) ? equipe : [];
        %>

        <% if (listaEquipe.length > 0) { %>
          <div class="equipe-grid equipe-grid--membros">
            <% listaEquipe.forEach((membro, index) => { %>
              <article
                class="equipe-card equipe-card--membro equipe-reveal"
                style="--card-index: <%= index %>"
              >
                <div class="equipe-card__photo">
                  <% if (membro.imagemUrl) { %>
                    <img
                      src="<%= membro.imagemUrl %>"
                      alt="Foto de <%= membro.nome %>"
                      loading="lazy"
                      onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='grid';"
                    >
                  <% } %>

                  <div
                    class="equipe-card__initial"
                    <% if (membro.imagemUrl) { %>style="display:none"<% } %>
                    aria-hidden="true"
                  >
                    <%= (membro.nome || 'I').trim().charAt(0).toUpperCase() %>
                  </div>

                  <div class="equipe-card__photo-overlay"></div>
                </div>

                <div class="equipe-card__content">
                  <span class="equipe-card__number">
                    <%= String(index + 1).padStart(2, '0') %>
                  </span>

                  <h3><%= membro.nome %></h3>

                  <% if (membro.cargo) { %>
                    <p class="equipe-card__role"><%= membro.cargo %></p>
                  <% } %>

                  <% if (membro.descricao) { %>
                    <p class="equipe-card__description"><%= membro.descricao %></p>
                  <% } %>

                  <span class="equipe-card__bottom-line"></span>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <div class="equipe-empty equipe-reveal">
            <div class="equipe-empty__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"
                  stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round"/>
                <circle cx="9.5" cy="7" r="4"
                  stroke="currentColor" stroke-width="1.6"/>
                <path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
                  stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round"/>
              </svg>
            </div>

            <h3>Novos integrantes em breve</h3>
            <p>
              As informações dos integrantes da equipe serão disponibilizadas
              em breve.
            </p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- CHAMADA FINAL -->
    <section class="equipe-cta">
      <div class="equipe-cta__pattern" aria-hidden="true"></div>

      <div class="equipe-container equipe-cta__content equipe-reveal">
        <span class="equipe-eyebrow equipe-eyebrow--light">
          <span class="equipe-eyebrow__line"></span>
          Vamos construir juntos
        </span>

        <h2>
          A inovação acontece
          <span>quando colaboramos.</span>
        </h2>

        <p>
          Quer conhecer melhor nosso trabalho ou conversar sobre
          possibilidades de colaboração? Estamos à disposição.
        </p>

        <a href="/contato" class="equipe-button equipe-button--light">
          Entre em contato
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14m-6-6 6 6-6 6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>

      <div class="equipe-cta__watermark" aria-hidden="true">IONOS</div>
    </section>
  </main>

  <%- include('partials/footer.ejs') %>

  <script src="/js/menu.js" defer></script>
  <script src="/js/equipe.js" defer></script>
</body>
</html>
