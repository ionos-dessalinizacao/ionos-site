
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || "Ionos | Dessalinização" %></title>

  <meta
    name="description"
    content="Conheça a Ionos Dessalinização: inovação e tecnologia para soluções sustentáveis de tratamento e dessalinização de água."
  >
  <meta name="theme-color" content="#FFFFFF">

  <link rel="icon" href="/images/logo/icon-ionos.png" type="image/png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body class="pagina-inicial">
  <%- include('partials/header.ejs') %>

  <main>
    <!-- HERO / APRESENTAÇÃO -->
    <section class="home-hero">
      <div class="home-hero-media" aria-hidden="true">
        <video
          class="home-hero-video"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="/videos/agua.mp4" type="video/mp4">
        </video>

        <div class="home-hero-overlay"></div>
      </div>

      <div class="home-hero-content home-reveal">
        <span class="home-eyebrow home-eyebrow-light">
          Tecnologia para transformar a água
        </span>

        <h1>
          <% if (
            typeof conteudoInicio !== "undefined" &&
            conteudoInicio &&
            conteudoInicio.hero &&
            conteudoInicio.hero.titulo
          ) { %>
            <%- conteudoInicio.hero.titulo %>
          <% } else { %>
            Novas possibilidades para um futuro com <em>mais água</em>.
          <% } %>
        </h1>

        <p>
          <% if (
            typeof conteudoInicio !== "undefined" &&
            conteudoInicio &&
            conteudoInicio.hero &&
            conteudoInicio.hero.descricao
          ) { %>
            <%= conteudoInicio.hero.descricao %>
          <% } else { %>
            Desenvolvemos soluções tecnológicas para o tratamento e a dessalinização da água, conectando ciência, inovação e sustentabilidade.
          <% } %>
        </p>

        <div class="home-hero-actions">
          <a
            class="home-button home-button-accent"
            href="<%= typeof conteudoInicio !== 'undefined' && conteudoInicio && conteudoInicio.hero && conteudoInicio.hero.botaoLink ? conteudoInicio.hero.botaoLink : '/sobre' %>"
          >
            <%= typeof conteudoInicio !== 'undefined' && conteudoInicio && conteudoInicio.hero && conteudoInicio.hero.botaoTexto ? conteudoInicio.hero.botaoTexto : 'Conheça a Ionos' %>
            <span aria-hidden="true">↗</span>
          </a>

          <a class="home-text-link home-text-link-light" href="/aplicacoes">
            Explore nossas aplicações <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <a
        href="#tecnologia"
        class="home-scroll-cue"
        aria-label="Descer para conhecer a tecnologia"
      >
        <span></span>
        <small>Descubra</small>
      </a>

      <div class="home-hero-index" aria-hidden="true">IONOS / 01</div>
    </section>

    <!-- INTRODUÇÃO -->
    <section class="home-intro section-space" id="tecnologia">
      <div class="home-container home-intro-grid">
        <div class="home-intro-heading home-reveal">
          <span class="home-eyebrow">Ciência em movimento</span>

          <h2>
            A água como ponto de partida para
            <em>novas soluções.</em>
          </h2>
        </div>

        <div class="home-intro-copy home-reveal">
          <p>
            Acreditamos que a inovação pode transformar a forma como
            tratamos e utilizamos a água. Por isso, unimos pesquisa,
            engenharia e tecnologia para desenvolver alternativas
            alinhadas aos desafios de hoje e de amanhã.
          </p>

          <a href="/sobre" class="home-text-link">
            Descubra nossa história <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- PILARES / TECNOLOGIA -->
    <section class="home-technology section-space">
      <div class="home-container">
        <div class="home-section-heading home-reveal">
          <div>
            <span class="home-eyebrow">
              <%= typeof conteudoInicio !== "undefined" && conteudoInicio && conteudoInicio.tecnologia && conteudoInicio.tecnologia.eyebrow ? conteudoInicio.tecnologia.eyebrow : 'Nossa abordagem' %>
            </span>

            <h2>
              <%= typeof conteudoInicio !== "undefined" && conteudoInicio && conteudoInicio.tecnologia && conteudoInicio.tecnologia.titulo ? conteudoInicio.tecnologia.titulo : 'Tecnologia com propósito.' %>
            </h2>
          </div>

          <p>
            <%= typeof conteudoInicio !== "undefined" && conteudoInicio && conteudoInicio.tecnologia && conteudoInicio.tecnologia.subtitulo ? conteudoInicio.tecnologia.subtitulo : 'Desenvolvemos caminhos para tornar o tratamento da água mais eficiente e sustentável.' %>
          </p>
        </div>

        <div class="home-pillar-grid">
          <% if (
            typeof conteudoInicio !== "undefined" &&
            conteudoInicio &&
            conteudoInicio.tecnologia &&
            Array.isArray(conteudoInicio.tecnologia.cards) &&
            conteudoInicio.tecnologia.cards.length
          ) { %>
            <% conteudoInicio.tecnologia.cards.forEach((card, index) => { %>
              <article class="home-pillar-card home-reveal">
                <div class="home-pillar-top">
                  <span class="home-pillar-number">
                    <%= String(index + 1).padStart(2, '0') %>
                  </span>

                  <span class="home-pillar-icon" aria-hidden="true">
                    <% if (index % 4 === 0) { %>
                      <svg viewBox="0 0 48 48" fill="none">
                        <path d="M24 5C19 13 10 22 10 30a14 14 0 0 0 28 0C38 22 29 13 24 5Z" />
                        <path d="M17 31c1 4 4 6 8 7" />
                      </svg>
                    <% } else if (index % 4 === 1) { %>
                      <svg viewBox="0 0 48 48" fill="none">
                        <circle cx="24" cy="24" r="15" />
                        <path d="M24 9v30M9 24h30M13 13l22 22M35 13 13 35" />
                      </svg>
                    <% } else if (index % 4 === 2) { %>
                      <svg viewBox="0 0 48 48" fill="none">
                        <path d="M8 35h32M12 30l8-9 6 5 11-15" />
                        <path d="M29 11h8v8" />
                      </svg>
                    <% } else { %>
                      <svg viewBox="0 0 48 48" fill="none">
                        <circle cx="24" cy="24" r="16" />
                        <path d="M24 14v10l7 5" />
                        <path d="M18 4h12" />
                      </svg>
                    <% } %>
                  </span>
                </div>

                <h3><%= card.titulo %></h3>
                <p><%= card.descricao %></p>
                <span class="home-card-line" aria-hidden="true"></span>
              </article>
            <% }) %>
          <% } else { %>
            <article class="home-pillar-card home-reveal">
              <div class="home-pillar-top">
                <span class="home-pillar-number">01</span>
                <span class="home-pillar-icon" aria-hidden="true">◇</span>
              </div>
              <h3>Pesquisa e desenvolvimento</h3>
              <p>Conhecimento científico aplicado à busca de novas soluções.</p>
              <span class="home-card-line" aria-hidden="true"></span>
            </article>

            <article class="home-pillar-card home-reveal">
              <div class="home-pillar-top">
                <span class="home-pillar-number">02</span>
                <span class="home-pillar-icon" aria-hidden="true">⌁</span>
              </div>
              <h3>Inovação tecnológica</h3>
              <p>Tecnologia pensada para enfrentar desafios reais.</p>
              <span class="home-card-line" aria-hidden="true"></span>
            </article>

            <article class="home-pillar-card home-reveal">
              <div class="home-pillar-top">
                <span class="home-pillar-number">03</span>
                <span class="home-pillar-icon" aria-hidden="true">◎</span>
              </div>
              <h3>Eficiência hídrica</h3>
              <p>Novas possibilidades para o tratamento da água.</p>
              <span class="home-card-line" aria-hidden="true"></span>
            </article>

            <article class="home-pillar-card home-reveal">
              <div class="home-pillar-top">
                <span class="home-pillar-number">04</span>
                <span class="home-pillar-icon" aria-hidden="true">✳</span>
              </div>
              <h3>Sustentabilidade</h3>
              <p>Desenvolvimento alinhado às necessidades ambientais.</p>
              <span class="home-card-line" aria-hidden="true"></span>
            </article>
          <% } %>
        </div>
      </div>
    </section>

    <!-- CONQUISTAS / DESTAQUES -->
    <section class="home-highlights section-space">
      <div class="home-container">
        <div class="home-section-heading home-reveal">
          <div>
            <span class="home-eyebrow">
              <%= typeof conteudoInicio !== "undefined" && conteudoInicio && conteudoInicio.conquistas && conteudoInicio.conquistas.eyebrow ? conteudoInicio.conquistas.eyebrow : 'Pesquisa e desenvolvimento' %>
            </span>

            <h2>
              <%= typeof conteudoInicio !== "undefined" && conteudoInicio && conteudoInicio.conquistas && conteudoInicio.conquistas.titulo ? conteudoInicio.conquistas.titulo : 'Ideias que ganham forma.' %>
            </h2>
          </div>

          <p>
            <%= typeof conteudoInicio !== "undefined" && conteudoInicio && conteudoInicio.conquistas && conteudoInicio.conquistas.descricao ? conteudoInicio.conteudoInicio?.conquistas?.descricao : 'Conheça os avanços, projetos e iniciativas que fazem parte da nossa jornada.' %>
          </p>
        </div>

        <div class="home-highlight-grid">
          <% if (
            typeof conteudoInicio !== "undefined" &&
            conteudoInicio &&
            conteudoInicio.conquistas &&
            Array.isArray(conteudoInicio.conquistas.cards) &&
            conteudoInicio.conquistas.cards.length
          ) { %>
            <% conteudoInicio.conquistas.cards.forEach((card, index) => { %>
              <article class="home-highlight-card home-reveal">
                <div class="home-highlight-image">
                  <img
                    src="<%= card.imagemUrl || '/images/agua.jpg' %>"
                    alt="<%= card.titulo %>"
                    loading="lazy"
                  >
                  <span class="home-highlight-index">
                    <%= String(index + 1).padStart(2, '0') %>
                  </span>
                </div>

                <div class="home-highlight-content">
                  <% if (card.tag) { %>
                    <span class="home-tag"><%= card.tag %></span>
                  <% } %>

                  <h3><%= card.titulo %></h3>
                  <p><%= card.descricao %></p>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <article class="home-highlight-card home-reveal">
              <div class="home-highlight-image">
                <img
                  src="/images/equipe/equipe-escada.jpg"
                  alt="Equipe da Ionos Dessalinização"
                  loading="lazy"
                >
                <span class="home-highlight-index">01</span>
              </div>
              <div class="home-highlight-content">
                <span class="home-tag">Pesquisa</span>
                <h3>Ciência aplicada à água</h3>
                <p>Pesquisa e desenvolvimento para ampliar as possibilidades de tratamento da água.</p>
              </div>
            </article>

            <article class="home-highlight-card home-reveal">
              <div class="home-highlight-image">
                <img
                  src="/images/equipe/equipe-escada.jpg"
                  alt="Equipe trabalhando em inovação"
                  loading="lazy"
                >
                <span class="home-highlight-index">02</span>
              </div>
              <div class="home-highlight-content">
                <span class="home-tag">Tecnologia</span>
                <h3>Do laboratório à aplicação</h3>
                <p>Transformamos conhecimento técnico em soluções para desafios concretos.</p>
              </div>
            </article>

            <article class="home-highlight-card home-reveal">
              <div class="home-highlight-image">
                <img
                  src="/images/equipe/equipe-escada.jpg"
                  alt="Time Ionos Dessalinização"
                  loading="lazy"
                >
                <span class="home-highlight-index">03</span>
              </div>
              <div class="home-highlight-content">
                <span class="home-tag">Colaboração</span>
                <h3>Inovação feita em equipe</h3>
                <p>Conectamos pessoas, ciência e engenharia para desenvolver novas ideias.</p>
              </div>
            </article>
          <% } %>
        </div>
      </div>
    </section>

    <!-- CHAMADA PARA CONTATO -->
    <section class="home-cta-section">
      <div class="home-container">
        <div class="home-cta-panel home-reveal">
          <div class="home-cta-decoration" aria-hidden="true"></div>

          <div class="home-cta-copy">
            <span class="home-eyebrow home-eyebrow-light">
              Vamos conversar
            </span>

            <h2>
              O futuro da água começa com
              <em>novas ideias.</em>
            </h2>

            <p>
              Quer conhecer melhor nossas soluções ou conversar sobre uma
              oportunidade de colaboração? Entre em contato com a Ionos.
            </p>

            <a href="/contato" class="home-button home-button-accent">
              Fale com a nossa equipe <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="home-cta-mark" aria-hidden="true">
            <span>IONOS</span>
            <span>DESSALINIZAÇÃO</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer.ejs') %>

  <script>
    (() => {
      const elements = document.querySelectorAll(".home-reveal");

      if (!("IntersectionObserver" in window)) {
        elements.forEach((element) => {
          element.classList.add("home-visible");
        });
        return;
      }

      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("home-visible");
              currentObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -30px 0px"
        }
      );

      elements.forEach((element) => observer.observe(element));
    })();
  </script>
</body>
</html>
