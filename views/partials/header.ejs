
<link rel="stylesheet" href="/css/header.css">

<header class="site-header">
  <nav class="site-nav" aria-label="Navegação principal">
    <a href="/" class="site-logo" aria-label="Ionos Dessalinização - Início">
      <img
        src="/images/logo/logo-ionos-branca.png"
        data-logo-white="/images/logo/logo-ionos-branca.png"
        data-logo-color="/images/logo/ionos-logo.png"
        alt="Ionos Dessalinização"
      >
    </a>

    <button
      class="mobile-menu-toggle"
      id="mobile-menu-button"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="desktop-navigation">
      <a href="/" class="nav-link">Início</a>

      <div class="nav-dropdown">
        <a href="/sobre" class="nav-link nav-dropdown-trigger">
          A Ionos
          <span class="nav-chevron" aria-hidden="true">⌄</span>
        </a>

        <div class="nav-dropdown-menu">
          <a href="/sobre">Sobre nós</a>
          <a href="/equipe">Nossa equipe</a>
        </div>
      </div>

      <% if (
        typeof configuracoes !== "undefined" &&
        configuracoes &&
        configuracoes.aplicacoesAtivas
      ) { %>
        <a href="/aplicacoes" class="nav-link">Aplicações</a>
      <% } %>

      <% if (
        typeof configuracoes !== "undefined" &&
        configuracoes &&
        configuracoes.noticiasAtivas
      ) { %>
        <a href="/noticias" class="nav-link">Notícias</a>
      <% } %>
    </div>

    <div class="header-actions">
      <div class="language-selector">
        <button
          type="button"
          class="language-button"
          id="language-button"
          aria-expanded="false"
          aria-controls="language-menu"
        >
          <span id="current-language">PT</span>
          <span aria-hidden="true">⌄</span>
        </button>

        <div class="language-menu" id="language-menu" hidden>
          <button type="button" data-language="pt">Português</button>
          <button type="button" data-language="en">English</button>
        </div>
      </div>

      <a href="/login" class="header-login">Login</a>
      <a href="/contato" class="header-contact">Contato</a>
    </div>
  </nav>

  <div class="mobile-navigation" id="mobile-menu" hidden>
    <a href="/">Início</a>
    <a href="/sobre">Sobre nós</a>
    <a href="/equipe">Nossa equipe</a>

    <% if (
      typeof configuracoes !== "undefined" &&
      configuracoes &&
      configuracoes.aplicacoesAtivas
    ) { %>
      <a href="/aplicacoes">Aplicações</a>
    <% } %>

    <% if (
      typeof configuracoes !== "undefined" &&
      configuracoes &&
      configuracoes.noticiasAtivas
    ) { %>
      <a href="/noticias">Notícias</a>
    <% } %>

    <a href="/contato">Contato</a>
    <a href="/login">Login</a>
  </div>

  <div
    id="google_translate_element"
    class="google-translate-hidden"
  ></div>
</header>

<script>
  (() => {
    const header = document.querySelector(".site-header");

    if (!header || header.dataset.initialized === "true") {
      return;
    }

    header.dataset.initialized = "true";

    const mobileButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const languageButton = document.getElementById("language-button");
    const languageMenu = document.getElementById("language-menu");
    const currentLanguage = document.getElementById("current-language");

    // Menu mobile
    mobileButton?.addEventListener("click", () => {
      const isOpen =
        mobileButton.getAttribute("aria-expanded") === "true";

      mobileButton.setAttribute("aria-expanded", String(!isOpen));
      mobileButton.setAttribute(
        "aria-label",
        isOpen ? "Abrir menu" : "Fechar menu"
      );

      if (mobileMenu) {
        mobileMenu.hidden = isOpen;
      }

      header.classList.toggle("menu-open", !isOpen);
    });

    // Seletor de idiomas
    languageButton?.addEventListener("click", () => {
      const isOpen =
        languageButton.getAttribute("aria-expanded") === "true";

      languageButton.setAttribute("aria-expanded", String(!isOpen));

      if (languageMenu) {
        languageMenu.hidden = isOpen;
      }
    });

    // Troca de idioma
    languageMenu?.querySelectorAll("[data-language]").forEach((button) => {
      button.addEventListener("click", () => {
        const language = button.dataset.language;

        if (currentLanguage) {
          currentLanguage.textContent = language === "en" ? "EN" : "PT";
        }

        languageButton?.setAttribute("aria-expanded", "false");

        if (languageMenu) {
          languageMenu.hidden = true;
        }

        const translateSelect = document.querySelector(".goog-te-combo");

        if (translateSelect) {
          translateSelect.value = language;
          translateSelect.dispatchEvent(new Event("change"));
        } else {
          console.warn(
            "O Google Translate ainda não está disponível nesta página."
          );
        }
      });
    });

    // Fecha o seletor de idiomas ao clicar fora do cabeçalho
    document.addEventListener("click", (event) => {
      if (!header.contains(event.target)) {
        languageButton?.setAttribute("aria-expanded", "false");

        if (languageMenu) {
          languageMenu.hidden = true;
        }
      }
    });

    // Fecha o menu mobile ao voltar para o desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth > 900) {
        if (mobileMenu) {
          mobileMenu.hidden = true;
        }

        mobileButton?.setAttribute("aria-expanded", "false");
        mobileButton?.setAttribute("aria-label", "Abrir menu");
        header.classList.remove("menu-open");
      }
    });

    // Fecha o menu mobile ao selecionar um link
    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.hidden = true;
        mobileButton?.setAttribute("aria-expanded", "false");
        mobileButton?.setAttribute("aria-label", "Abrir menu");
        header.classList.remove("menu-open");
      });
    });
  })();

  // Inicialização do Google Translate
  function googleTranslateElementInit() {
    if (
      window.google &&
      google.translate &&
      google.translate.TranslateElement
    ) {
      new google.translate.TranslateElement(
        {
          pageLanguage: "pt",
          includedLanguages: "pt,en",
          autoDisplay: false
        },
        "google_translate_element"
      );
    }
  }
</script>

<script
  src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
  defer
></script>

<script src="/js/menu.js" defer></script>
