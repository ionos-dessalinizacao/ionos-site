<!DOCTYPE html>

<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/css/admin.css"
  >

</head>


<body>


  <!-- =====================================
       HEADER
  ====================================== -->

  <header class="admin-header">

    <div class="admin-brand">

      <span class="admin-brand-name">
        Ionos
      </span>

      <span class="admin-brand-subtitle">
        Dessalinização
      </span>

    </div>


    <div class="admin-header-right">

      <span class="admin-header-title">
        Painel Administrativo
      </span>

      <a
        href="/login/sair"
        class="logout-button"
      >
        Sair
      </a>

    </div>

  </header>



  <!-- =====================================
       CONTEÚDO
  ====================================== -->

  <main class="admin-container">


    <!-- =====================================
         INTRODUÇÃO
    ====================================== -->

    <section class="admin-introduction">

      <span class="admin-label">
        ADMINISTRAÇÃO
      </span>

      <h1>
        Gerencie o site da Ionos
      </h1>

      <p>
        Escolha uma seção abaixo para
        editar e administrar o conteúdo
        do site.
      </p>

    </section>



    <!-- =====================================
         CARDS
    ====================================== -->

    <section class="admin-grid">


<!-- =====================================
     INÍCIO
====================================== -->

<section class="admin-card">

  <div class="admin-card-header">

    <div class="admin-card-icon">
      🏠
    </div>

    <div>
      <h2>
        Início
      </h2>

      <p>
        Gerencie os conteúdos
        apresentados na página inicial.
      </p>
    </div>

  </div>


  <!-- AÇÕES -->

  <div class="admin-card-actions">

    <a
      href="/admin/inicio"
      class="admin-button"
    >
      Administrar início
    </a>

  </div>

</section>


      <!-- =====================================
     EQUIPE
====================================== -->

<section class="admin-card">

  <div class="admin-card-header">

    <div class="admin-card-icon">
      👥
    </div>

    <div>
      <h2>
        Equipe
      </h2>

      <p>
        Gerencie membros,
        informações e fotos da equipe.
      </p>
    </div>

  </div>


  <!-- AÇÕES -->

  <div class="admin-card-actions">

    <a
      href="/admin/equipe"
      class="admin-button"
    >
      Administrar equipe
    </a>

  </div>

</section>


<!-- =====================================
     APLICAÇÕES
====================================== -->

<section class="admin-card admin-card-highlight">

  <div class="admin-card-header">

    <div class="admin-card-icon">
      ⚗️
    </div>

    <div>
      <h2>
        Aplicações
      </h2>

      <p>
        Gerencie aplicações,
        projetos e informações técnicas.
      </p>
    </div>

  </div>


  <!-- STATUS -->

  <div class="admin-section-status">

    <span class="admin-label">
      SEÇÃO DO SITE
    </span>

    <% if (configuracoes && configuracoes.aplicacoesAtivas) { %>

      <span class="status status-ativo">
        Ativa
      </span>

    <% } else { %>

      <span class="status status-inativo">
        Inativa
      </span>

    <% } %>

  </div>


  <!-- AÇÕES -->

  <div class="admin-card-actions">

    <a
      href="/admin/aplicacoes"
      class="admin-button"
    >
      Administrar aplicações
    </a>


    <% if (configuracoes && configuracoes.aplicacoesAtivas) { %>

      <button
        type="button"
        class="admin-button danger"
        onclick="desativarAplicacoes()"
      >
        Desativar seção
      </button>

    <% } else { %>

      <button
        type="button"
        class="admin-button success"
        onclick="ativarAplicacoes()"
      >
        Ativar seção
      </button>

    <% } %>

  </div>

</section>



      <!-- =====================================
           NOTÍCIAS
      ====================================== -->

      <section class="admin-card admin-card-highlight">

        <div class="admin-card-header">

          <div class="admin-card-icon">
            📰
          </div>

          <div>

            <h2>
              Notícias
            </h2>

            <p>
              Crie, edite, arquive e
              exclua notícias.
            </p>

          </div>

        </div>


        <!-- STATUS -->

        <div class="admin-section-status">

          <span class="admin-label">
            SEÇÃO DO SITE
          </span>


          <% if (configuracoes && configuracoes.noticiasAtivas) { %>

            <span class="status status-ativo">
              Ativa
            </span>

          <% } else { %>

            <span class="status status-inativo">
              Inativa
            </span>

          <% } %>

        </div>


        <!-- AÇÕES -->

        <div class="admin-card-actions">

          <a
            href="/admin/noticias"
            class="admin-button"
          >
            Administrar notícias
          </a>


          <% if (configuracoes && configuracoes.noticiasAtivas) { %>

            <button
              type="button"
              class="admin-button danger"
              onclick="desativarNoticias()"
            >
              Desativar seção
            </button>

          <% } else { %>

            <button
              type="button"
              class="admin-button success"
              onclick="ativarNoticias()"
            >
              Ativar seção
            </button>

          <% } %>

        </div>

      </section>



<!-- =====================================
     SOBRE
====================================== -->

<section class="admin-card">

  <div class="admin-card-header">

    <div class="admin-card-icon">
      ℹ️
    </div>

    <div>
      <h2>
        Sobre Nós
      </h2>

      <p>
        Gerencie informações,
        conquistas e conteúdos institucionais.
      </p>
    </div>

  </div>


  <!-- AÇÕES -->

  <div class="admin-card-actions">

    <a
      href="/admin/sobre"
      class="admin-button"
    >
      Administrar Sobre Nós
    </a>

  </div>

</section>


<!-- =====================================
     CONTATO
====================================== -->

<section class="admin-card">

  <div class="admin-card-header">

    <div class="admin-card-icon">
      ✉️
    </div>

    <div>
      <h2>
        Contato
      </h2>

      <p>
        Gerencie informações
        e canais de contato.
      </p>
    </div>

  </div>


  <!-- AÇÕES -->

  <div class="admin-card-actions">

    <a
      href="/admin/contato"
      class="admin-button"
    >
      Administrar contato
    </a>

  </div>

</section>

    </section>


  </main>



  <!-- =====================================
       FOOTER
  ====================================== -->

  <footer class="admin-footer">

    <p>
      Ionos Dessalinização
    </p>

    <span>
      Painel Administrativo
    </span>

  </footer>



  <!-- =====================================
       JAVASCRIPT
  ====================================== -->

  <script src="/js/admin.js"></script>

</body>

</html>