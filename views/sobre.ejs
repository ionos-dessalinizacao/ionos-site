<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Sobre Nós | Ionos</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

</head>


<body class="bg-gray-50 text-gray-800">

  <%- include('partials/header.ejs') %>


  <!-- =======================================================
       HERO
  ======================================================== -->

  <section class="relative overflow-hidden bg-[#007A8F] text-white py-28">

    <!-- Elementos decorativos -->

    <div
      class="absolute -top-32 -right-32 w-96 h-96
             bg-[#07C0D4] rounded-full
             opacity-30 blur-3xl"
    ></div>

    <div
      class="absolute -bottom-40 -left-32 w-96 h-96
             bg-white rounded-full
             opacity-10 blur-3xl"
    ></div>


    <div class="relative container mx-auto px-6 text-center max-w-5xl">

      <p
        class="text-[#07C0D4] font-semibold
               uppercase tracking-widest text-sm mb-4"
      >
        Quem somos
      </p>

      <h1 class="text-5xl md:text-6xl font-bold">
        Sobre a Ionos
      </h1>

      <div
        class="w-24 h-1 bg-[#07C0D4]
               rounded-full mx-auto mt-6 mb-8"
      ></div>

      <p
        class="text-xl leading-9
               text-white/90 max-w-3xl mx-auto"
      >
        Desenvolvendo tecnologias sustentáveis para democratizar
        o acesso à água de qualidade através da inovação em
        dessalinização.
      </p>

    </div>

  </section>



  <!-- =======================================================
       NOSSA HISTÓRIA
  ======================================================== -->

  <section class="py-24 bg-white">

    <div class="container mx-auto px-6 max-w-5xl">

      <div class="text-center mb-16">

        <p
          class="text-[#007A8F] font-semibold
                 uppercase tracking-widest text-sm mb-3"
        >
          Nossa trajetória
        </p>

        <h2 class="text-4xl md:text-5xl font-bold text-[#0D0D0D]">
          Nossa História
        </h2>

        <div
          class="w-20 h-1 bg-[#07C0D4]
                 rounded-full mx-auto mt-5"
        ></div>

      </div>


      <div
        class="space-y-8 text-[#5F5F5F]
               text-lg leading-9"
      >

        <p>
          A <strong class="text-[#007A8F]">Ionos Dessalinização</strong>
          nasceu com o propósito de democratizar o acesso à água de
          qualidade por meio da tecnologia. Nosso foco é desenvolver
          sistemas modulares de dessalinização baseados na
          <strong class="text-[#007A8F]">
            Deionização Capacitiva (CDI)
          </strong>,
          tecnologia emergente e com potencial de impacto,
          combinando eficiência energética e sustentabilidade.
        </p>

        <p>
          Nossa missão é transformar a gestão da água, oferecendo
          soluções escaláveis e inteligentes para residências,
          comunidades, pequenos negócios e indústrias.
          Atualmente, estamos em fase de desenvolvimento de nossa
          solução, com um nível de
          <strong class="text-[#007A8F]">
            maturidade tecnológica nível 4
          </strong>
          (validação em laboratório).
        </p>

        <p>
          Possuímos uma célula de dessalinização operando em
          diferentes vazões, capaz de reduzir a salinidade de
          soluções salobras, além de um sistema de controle e um
          aplicativo para monitoramento da qualidade da água
          operacionais.
        </p>

      </div>


      <div class="mt-12 text-center">

        <a
          href="/contato"
          class="inline-flex items-center
                 bg-[#007A8F]
                 hover:bg-[#005F70]
                 text-white
                 font-semibold
                 px-8 py-4
                 rounded-xl
                 transition duration-300
                 shadow-lg hover:shadow-xl"
        >
          Fale Conosco

          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 ml-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 7l5 5m0 0-5 5m5-5H6"
            />

          </svg>

        </a>

      </div>

    </div>

  </section>



  <!-- =======================================================
       NOSSOS PILARES
  ======================================================== -->

  <section class="py-24 bg-gray-50">

    <div class="container mx-auto px-6 max-w-6xl">

      <div class="text-center mb-16">

        <p
          class="text-[#007A8F] font-semibold
                 uppercase tracking-widest text-sm mb-3"
        >
          O que nos guia
        </p>

        <h2 class="text-4xl md:text-5xl font-bold text-[#0D0D0D]">
          Nossos Pilares
        </h2>

        <div
          class="w-24 h-1 bg-[#07C0D4]
                 rounded-full mx-auto mt-5 mb-6"
        ></div>

        <p
          class="text-[#5F5F5F]
                 max-w-2xl mx-auto
                 leading-8 text-lg"
        >
          Nossa atuação é guiada pela inovação, responsabilidade
          e compromisso com o desenvolvimento de tecnologias
          sustentáveis para o tratamento da água.
        </p>

      </div>


      <div class="grid md:grid-cols-3 gap-8">


        <!-- ===================================================
             MISSÃO
        ==================================================== -->

        <div
          class="group bg-white
                 rounded-3xl
                 shadow-lg
                 hover:shadow-2xl
                 transition-all duration-300
                 overflow-hidden
                 hover:-translate-y-2"
        >

          <div class="h-2 bg-[#07C0D4]"></div>

          <div class="p-10">

            <div
              class="w-16 h-16
                     flex items-center justify-center
                     rounded-2xl
                     bg-cyan-50
                     text-[#007A8F]
                     group-hover:bg-[#007A8F]
                     group-hover:text-white
                     transition duration-300
                     mb-8"
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-9 h-9"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v3m0 12v3m9-9h-3M6 12H3m15.364-6.364-2.121 2.121M7.757 16.243l-2.121 2.121m0-12.728 2.121 2.121m8.486 8.486 2.121 2.121M12 9a3 3 0 100 6 3 3 0 000-6"
                />

              </svg>

            </div>


            <h3 class="text-2xl font-bold text-[#0D0D0D] mb-5">
              Missão
            </h3>

            <p class="text-[#5F5F5F] leading-8">
              Democratizar o acesso à água de qualidade através
              de tecnologias sustentáveis e inovadoras de
              dessalinização.
            </p>

          </div>

        </div>



        <!-- ===================================================
             VISÃO
        ==================================================== -->

        <div
          class="group bg-white
                 rounded-3xl
                 shadow-lg
                 hover:shadow-2xl
                 transition-all duration-300
                 overflow-hidden
                 hover:-translate-y-2"
        >

          <div class="h-2 bg-[#07C0D4]"></div>

          <div class="p-10">

            <div
              class="w-16 h-16
                     flex items-center justify-center
                     rounded-2xl
                     bg-cyan-50
                     text-[#007A8F]
                     group-hover:bg-[#007A8F]
                     group-hover:text-white
                     transition duration-300
                     mb-8"
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-9 h-9"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9-9 4.03-9 9 4.03 9 9 9zm0-18c2.5 2.4 4 5.7 4 9s-1.5 6.6-4 9c-2.5-2.4-4-5.7-4-9s1.5-6.6 4-9zm-7 9h14"
                />

              </svg>

            </div>


            <h3 class="text-2xl font-bold text-[#0D0D0D] mb-5">
              Visão
            </h3>

            <p class="text-[#5F5F5F] leading-8">
              Tornar-se referência nacional no desenvolvimento
              de soluções inteligentes para tratamento e gestão
              da água.
            </p>

          </div>

        </div>



        <!-- ===================================================
             DIFERENCIAL
        ==================================================== -->

        <div
          class="group bg-white
                 rounded-3xl
                 shadow-lg
                 hover:shadow-2xl
                 transition-all duration-300
                 overflow-hidden
                 hover:-translate-y-2"
        >

          <div class="h-2 bg-[#07C0D4]"></div>

          <div class="p-10">

            <div
              class="w-16 h-16
                     flex items-center justify-center
                     rounded-2xl
                     bg-cyan-50
                     text-[#007A8F]
                     group-hover:bg-[#007A8F]
                     group-hover:text-white
                     transition duration-300
                     mb-8"
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-9 h-9"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3s6 6.2 6 10a6 6 0 11-12 0c0-3.8 6-10 6-10z"
                />

              </svg>

            </div>


            <h3 class="text-2xl font-bold text-[#0D0D0D] mb-5">
              Nosso Diferencial
            </h3>

            <p class="text-[#5F5F5F] leading-8">
              Integramos pesquisa científica, engenharia e
              desenvolvimento de software para criar soluções
              inteligentes e conectadas.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =======================================================
       GALERIA
  ======================================================== -->

  <section class="py-24 bg-white">

    <div class="container mx-auto px-6">

      <div class="text-center mb-16">

        <span
          class="uppercase tracking-widest
                 text-[#007A8F]
                 font-semibold text-sm"
        >
          Bastidores
        </span>

        <h2
          class="text-4xl md:text-5xl
                 font-bold text-[#0D0D0D]
                 mt-4"
        >
          Nossa Galeria
        </h2>

        <div
          class="w-20 h-1 bg-[#07C0D4]
                 rounded-full mx-auto mt-5 mb-6"
        ></div>

        <p
          class="text-[#5F5F5F]
                 mt-6 max-w-2xl mx-auto
                 leading-8 text-lg"
        >
          Alguns momentos da equipe durante reuniões,
          desenvolvimento, testes e atividades da Ionos.
        </p>

      </div>


      <div class="relative max-w-5xl mx-auto">

        <div
          class="overflow-hidden
                 rounded-3xl
                 shadow-2xl
                 bg-gray-100
                 border border-gray-100"
        >

          <img
            id="galleryImage"
            src="/images/equipe/equipe-escada.jpg"
            alt="Equipe Ionos"
            class="w-full h-[550px]
                   object-cover
                   cursor-pointer
                   transition duration-500
                   hover:scale-[1.01]"
          >

        </div>


        <!-- BOTÃO ANTERIOR -->

        <button
          id="prevBtn"
          type="button"
          aria-label="Imagem anterior"
          class="absolute left-5 top-1/2
                 -translate-y-1/2
                 bg-white
                 w-14 h-14
                 rounded-full
                 shadow-lg
                 hover:bg-[#007A8F]
                 hover:text-white
                 transition-all duration-300
                 text-2xl"
        >
          ❮
        </button>


        <!-- BOTÃO PRÓXIMO -->

        <button
          id="nextBtn"
          type="button"
          aria-label="Próxima imagem"
          class="absolute right-5 top-1/2
                 -translate-y-1/2
                 bg-white
                 w-14 h-14
                 rounded-full
                 shadow-lg
                 hover:bg-[#007A8F]
                 hover:text-white
                 transition-all duration-300
                 text-2xl"
        >
          ❯
        </button>

      </div>

    </div>

  </section>



  <!-- =======================================================
       LIGHTBOX
  ======================================================== -->

  <div
    id="lightbox"
    class="fixed inset-0
           bg-black/90
           z-[100]
           hidden
           items-center
           justify-center
           p-6"
  >

    <button
      id="closeLightbox"
      type="button"
      aria-label="Fechar imagem"
      class="absolute
             top-6 right-8
             text-white
             text-5xl
             leading-none
             hover:text-[#07C0D4]
             transition"
    >
      ×
    </button>


    <img
      id="lightboxImage"
      src=""
      alt="Imagem ampliada da galeria"
      class="max-w-6xl
             max-h-[90vh]
             rounded-2xl
             shadow-2xl
             object-contain"
    >

  </div>



  <!-- =======================================================
       FOOTER
  ======================================================== -->

  <%- include('partials/footer.ejs') %>


  <!-- =======================================================
       SCRIPTS
  ======================================================== -->

  <script>

    const galleryImages = [
      "/images/equipe/equipe-escada.jpg",
      "/images/equipe/equipe-jardim.jpg",
      "/images/equipe/socios-jessica-iago.jpg"
    ];

    let currentImage = 0;

    const galleryImage =
      document.getElementById("galleryImage");

    const prevBtn =
      document.getElementById("prevBtn");

    const nextBtn =
      document.getElementById("nextBtn");

    const lightbox =
      document.getElementById("lightbox");

    const lightboxImage =
      document.getElementById("lightboxImage");

    const closeLightbox =
      document.getElementById("closeLightbox");


    function updateGallery() {

      galleryImage.src =
        galleryImages[currentImage];

    }


    nextBtn.addEventListener("click", () => {

      currentImage++;

      if (currentImage >= galleryImages.length) {
        currentImage = 0;
      }

      updateGallery();

    });


    prevBtn.addEventListener("click", () => {

      currentImage--;

      if (currentImage < 0) {
        currentImage = galleryImages.length - 1;
      }

      updateGallery();

    });


    galleryImage.addEventListener("click", () => {

      lightboxImage.src =
        galleryImages[currentImage];

      lightbox.classList.remove("hidden");

      lightbox.classList.add("flex");

      document.body.classList.add("overflow-hidden");

    });


    function closeGallery() {

      lightbox.classList.add("hidden");

      lightbox.classList.remove("flex");

      document.body.classList.remove("overflow-hidden");

    }


    closeLightbox.addEventListener(
      "click",
      closeGallery
    );


    lightbox.addEventListener("click", (event) => {

      if (event.target === lightbox) {
        closeGallery();
      }

    });


    document.addEventListener("keydown", (event) => {

      if (event.key === "Escape") {
        closeGallery();
      }

    });

  </script>


  <script src="/js/menu.js"></script>

</body>

</html>