<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Contato | Ionos</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

</head>

<body>

  <%- include('partials/header.ejs') %>
<!-- =======================================================
     CONTATO
======================================================= -->

<section id="contact" class="relative py-24 overflow-hidden bg-gray-50">

  <!-- Elementos decorativos -->
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-cyan-100 rounded-full blur-3xl opacity-50"></div>
  <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-blue-100 rounded-full blur-3xl opacity-50"></div>

  <div class="relative container mx-auto px-6">

    <!-- Cabeçalho -->
    <div class="text-center max-w-3xl mx-auto mb-16">

      <p class="text-[#07C0D4] font-semibold uppercase tracking-widest text-sm mb-3">
        Fale conosco
      </p>

      <h2 class="text-4xl md:text-5xl font-bold text-[#0D0D0D]">
        Entre em Contato
      </h2>

      <div class="w-20 h-1 bg-[#07C0D4] rounded-full mx-auto mt-5"></div>

      <p class="text-[#5F5F5F] max-w-2xl mx-auto mt-6 leading-8">
        Estamos abertos a parcerias, projetos piloto e colaborações de pesquisa.
        Se você tem um desafio relacionado à água ou quer aplicar nossa tecnologia,
        vamos conversar.
      </p>

    </div>


    <!-- Formulário -->
    <div class="max-w-3xl mx-auto">

      <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8 md:p-10">

        <form
          action="https://formspree.io/f/xdkpprwr"
          method="POST"
          class="space-y-6"
        >

          <!-- Nome + E-mail -->
          <div class="grid md:grid-cols-2 gap-6">

            <!-- Nome -->
            <div>

              <label
                for="nome"
                class="block text-sm font-semibold text-[#0D0D0D] mb-2"
              >
                Nome
              </label>

              <input
                id="nome"
                type="text"
                name="Nome"
                placeholder="Seu Nome"
                class="w-full px-4 py-3.5
                       bg-gray-50
                       border border-gray-200
                       rounded-xl
                       text-[#0D0D0D]
                       placeholder-gray-400
                       outline-none
                       focus:border-[#07C0D4]
                       focus:ring-2 focus:ring-cyan-100
                       transition duration-200"
                required
              >

            </div>


            <!-- E-mail -->
            <div>

              <label
                for="email"
                class="block text-sm font-semibold text-[#0D0D0D] mb-2"
              >
                E-mail
              </label>

              <input
                id="email"
                type="email"
                name="_replyto"
                placeholder="Seu E-mail"
                class="w-full px-4 py-3.5
                       bg-gray-50
                       border border-gray-200
                       rounded-xl
                       text-[#0D0D0D]
                       placeholder-gray-400
                       outline-none
                       focus:border-[#07C0D4]
                       focus:ring-2 focus:ring-cyan-100
                       transition duration-200"
                required
              >

            </div>

          </div>


          <!-- Assunto -->
          <div>

            <label
              for="assunto"
              class="block text-sm font-semibold text-[#0D0D0D] mb-2"
            >
              Assunto
            </label>

            <input
              id="assunto"
              type="text"
              name="Assunto"
              placeholder="Ex: Parceria de Pesquisa, Projeto Piloto"
              class="w-full px-4 py-3.5
                     bg-gray-50
                     border border-gray-200
                     rounded-xl
                     text-[#0D0D0D]
                     placeholder-gray-400
                     outline-none
                     focus:border-[#07C0D4]
                     focus:ring-2 focus:ring-cyan-100
                     transition duration-200"
            >

          </div>


          <!-- Mensagem -->
          <div>

            <label
              for="mensagem"
              class="block text-sm font-semibold text-[#0D0D0D] mb-2"
            >
              Mensagem
            </label>

            <textarea
              id="mensagem"
              name="Mensagem"
              placeholder="Sua Mensagem"
              rows="6"
              class="w-full px-4 py-3.5
                     bg-gray-50
                     border border-gray-200
                     rounded-xl
                     text-[#0D0D0D]
                     placeholder-gray-400
                     outline-none
                     resize-none
                     focus:border-[#07C0D4]
                     focus:ring-2 focus:ring-cyan-100
                     transition duration-200"
              required
            ></textarea>

          </div>


          <!-- Botão -->
          <div class="pt-2">

            <button
              type="submit"
              class="w-full
                     bg-[#007A8F]
                     text-white
                     py-4 px-8
                     rounded-xl
                     text-lg
                     font-semibold
                     hover:bg-[#005F70]
                     hover:shadow-lg
                     hover:-translate-y-0.5
                     transition-all duration-300"
            >
              Enviar Contato
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>

<!-- =======================================================
     FIM DO CONTATO
======================================================= -->
```


  <%- include('partials/footer.ejs') %>

</body>

</html>